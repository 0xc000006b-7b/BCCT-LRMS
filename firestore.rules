rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "clintralphopena@gmail.com";
    }
    match /qualifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /registrations/{id} {
      allow create: if request.resource.data.keys().hasAll(['ln','fn','qual','date'])
                    && request.resource.data.uli == ""
                    && request.resource.data.photo.size() < 700000;
      allow read, update, delete: if isAdmin();
    }
  }
}
